{
  "expo": {
    "name": "cocodake",
    "slug": "cocodake",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cocodake",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cocodake.app",
      "appleTeamId": "723PYY2A7A",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "現在地をマップ上に表示し、近くのスポットを探すために使用します",
        "NSPhotoLibraryUsageDescription": "Google TakeoutのJSONファイルなど、保存済みスポットのデータをインポートするために使用します",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.cocodake.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "./plugins/withAndroidShareIntent",
      "./plugins/withShareExtensionProfile",
      "./plugins/withiOSShareExtension",
      "expo-secure-store",
      "expo-web-browser",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地をマップ上に表示し、近くのスポットを探すために使用します"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "./plugins/withIOSResourceBundleFix"
    ],
    "extra": {
      "eas": {
        "projectId": "e4277472-c477-4f6b-80e9-62890989e090"
      }
    },
    "owner": "yukik8"
  }
}
